{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@issuedesk/shared": ["../../packages/shared/src/*"],
      "@issuedesk/github-api": ["../../packages/github-api/src/*"]
    },
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "App.tsx",
    "index.ts"
, "../cloudflare.d.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
