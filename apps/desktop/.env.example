# Environment Variables for IssueDesk Desktop
# Copy this file to .env for production builds
# This file is used during packaging and distribution

# =============================================================================
# Backend Configuration (REQUIRED for Production)
# =============================================================================

# Production Authentication Worker URL
# Replace with your deployed Cloudflare Worker URL
# Example: https://yourname.workers.dev
PROD_AUTH_WORKER_URL=https://yourname.workers.dev

# Or use AUTH_WORKER_URL to override for all environments
# AUTH_WORKER_URL=https://yourname.workers.dev

# =============================================================================
# Build Configuration
# =============================================================================

# Node environment for production builds
#NODE_ENV=production

# Electron production mode
#ELECTRON_IS_DEV=0

# =============================================================================
# Code Signing (macOS)
# =============================================================================

# Apple Developer ID for code signing (optional)
# Required for distribution outside the Mac App Store
# APPLE_ID=your-apple-id@example.com
# APPLE_ID_PASSWORD=app-specific-password
# APPLE_TEAM_ID=XXXXXXXXXX

# Certificate identity for signing
# SIGNING_IDENTITY=Developer ID Application: Your Name (TEAM_ID)

# =============================================================================
# Notarization (macOS)
# =============================================================================

# Required for macOS 10.15+ distribution
# NOTARIZE=true
# NOTARIZE_APPLE_ID=your-apple-id@example.com
# NOTARIZE_APPLE_ID_PASSWORD=app-specific-password
# NOTARIZE_TEAM_ID=XXXXXXXXXX

# =============================================================================
# Windows Signing
# =============================================================================

# Certificate file path for Windows code signing
# WIN_CSC_LINK=path/to/certificate.pfx
# WIN_CSC_KEY_PASSWORD=certificate-password

# =============================================================================
# Additional Configuration
# =============================================================================

# Add any other custom environment variables here
